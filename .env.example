# Copy to .env and fill in values (.env is gitignored)
#
# Used by: Supabase CLI (link, deploy)
# Angular app uses src/environments/environment.ts — not .env

# --- Local reference (NOT uploaded by `supabase secrets set` — Supabase skips SUPABASE_*) ---
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Edge Function secrets (uploaded by: supabase secrets set --env-file .env) ---
RESEND_API_KEY=re_your_resend_key
REMINDER_FROM_EMAIL="My Calendar <onboarding@resend.dev>"
APP_URL=https://my-calendar-frontend-mvp.vercel.app

# --- Google OAuth (local reference — set in Supabase Dashboard → Auth → Providers → Google) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
